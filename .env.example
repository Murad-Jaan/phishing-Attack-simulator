# Environment
ENV=development
APP_ENV=development
APP_BASE_URL=http://127.0.0.1:3000
API_BASE_URL=http://127.0.0.1:8000

# Secrets (use your own values)
SESSION_SECRET=changeme-session-secret-min-32-chars
CSRF_SECRET=changeme-csrf-secret-min-32-chars

# Database
POSTGRES_USER=phish
POSTGRES_PASSWORD=phishpass
POSTGRES_DB=phishsim
DATABASE_URL=postgresql+psycopg://phish:phishpass@postgres:5432/phishsim
TEST_DATABASE_URL=postgresql+psycopg://phish:phishpass@postgres:5432/phishsim_test

# Redis
REDIS_URL=redis://redis:6379/0
TEST_REDIS_URL=redis://redis:6379/15

# Mail
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=sandbox@example.test
ALLOWED_SEND_DOMAINS=example.com,*.test,*.invalid

# Settings
RETENTION_DAYS=90
REPORTING_MIN_GROUP=5
ANALYZER_MAX_UPLOAD_MB=5
ANALYZER_MAX_PASTE_MB=2

# Demo admin passwords - real values go in .env only, never commit them
DEMO_ADMIN_1_PASSWORD=
DEMO_ADMIN_2_PASSWORD=

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
